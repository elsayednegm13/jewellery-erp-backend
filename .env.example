PORT=8000
NODE_ENV=development

# JWT — generate strong secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the app refuses to start with a missing/default/short (<32) secret.
JWT_SECRET=change_me_with_a_long_random_value
JWT_REFRESH_SECRET=change_me_with_a_different_long_random_value
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated frontend origins. Required in production.
# FRONTEND_URL is also added to the allow-list automatically.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database Configuration. Development may use local defaults; staging and
# production require explicit values or DATABASE_URL and fail before connecting.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=change_me
DB_PASS=change_me
# Docker Compose often provides DB_PASSWORD; backend accepts either DB_PASS or DB_PASSWORD.
DB_PASSWORD=change_me
DB_NAME=darfus_erp
# Set DB_SSL=true for managed/remote Postgres that requires SSL (production)
DB_SSL=false

# Per-run verifier confirmations. Keep disabled/blank in persistent env files.
VERIFY_DATABASE_HOST=
VERIFY_DATABASE_PORT=
VERIFY_DATABASE_NAME=
VERIFY_LOCAL_DATABASE=false
OWNER_CONFIRMED_TEST_DATABASE=false
VERIFY_LIVE_DATABASE=false
VERIFY_RUN_ID=
VERIFY_BACKUP_PATH=

# Guarded first-run setup. Never use a default value and never commit a real
# token. The token is consumed logically once setup reaches READY; the setup
# endpoint remains unavailable without it in every environment.
FIRST_RUN_SETUP_TOKEN=

# Legacy local ensureAdmin variables are not a supported installation path.
# Do not use them to create a production/staging administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PHONE=

# Redis (optional — in-memory fallback used when absent)
REDIS_URL=

# Gold Price API Integration (simulated fallback used when key is empty)
# Options: goldapi, metalsapi, goldpriceapi
GOLD_API_PROVIDER=goldapi
GOLD_API_KEY=

# Backups: full path to pg_dump if it is not on PATH
PG_DUMP=pg_dump
